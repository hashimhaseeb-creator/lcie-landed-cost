# ---- Database (REQUIRED) ----
# Neon (free tier recommended): https://neon.tech → create a project → copy "Connection string"
# Shape: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- Z.ai SDK (REQUIRED for the LLM HS-classification agent) ----
# Sign up at https://z.ai, get an API key, set the base URL.
# If left blank, the agent falls back to KB-only mode (still works, just no LLM classification).
ZAI_API_KEY=""
ZAI_BASE_URL="https://api.z.ai/api/v1"

# ---- NextAuth (only if you add authentication later) ----
# NEXTAUTH_SECRET=""        # generate with: openssl rand -base64 32
# NEXTAUTH_URL="http://localhost:3000"
